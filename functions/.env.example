# 이 파일을 복사해서 `.env` 로 저장한 뒤 실제 값을 채워넣으세요.
# `.env` 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록됨).

# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 알림 받을 텔레그램 chat_id (본인 개인 계정, 양수 숫자)
TELEGRAM_CHAT_ID=12345678

# Resend API 키 (Sending access)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx

# 알림 받을 개인 이메일 (Resend 가입한 이메일)
NOTIFY_EMAIL=your-personal@example.com

# 발송자 이메일 (커스텀 도메인 인증 전에는 이 기본값 그대로)
EMAIL_FROM=onboarding@resend.dev

# 관리자 페이지 URL (Firebase Hosting 기본값)
ADMIN_URL=https://jasup-feedback.web.app/admin.html
